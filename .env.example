# Optional absolute or repository-relative location for local records and PDFs.
PHOTO_STUDIO_DATA_DIR=data

# GitHub Actions secrets required to build and publish a notarized macOS release.
# Keep the actual values in repository Settings > Secrets and variables > Actions.
# Set this to 1 only for a notarized release build; leave local builds at 0.
PHOTO_STUDIO_NOTARIZE=0
# CSC_LINK is a base64-encoded Developer ID Application .p12 certificate.
CSC_LINK=
# Password used to decrypt the .p12 certificate.
CSC_KEY_PASSWORD=
# Optional GitHub Actions variable: exact identity name from the Developer ID certificate.
# Example: Developer ID Application: Photographer Name (ABCDE12345)
CSC_NAME=
# APPLE_API_KEY is the one-line base64-encoded App Store Connect .p8 private key.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
