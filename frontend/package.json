{
  "name": "photo-contract-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Local client, booking, agreement, invoice, and document management for photographers.",
  "author": "Contract Studio",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "desktop": "npm run build && electron .",
    "desktop:launch": "electron .",
    "build:mac": "python3 ../scripts/build_macos_app.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.76.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.15.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.riophotography.documentstudio",
    "productName": "Contract Studio",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/loading.html",
      "assets/contract-studio-icon.png",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/macos_app/backend/photography-document-studio-backend",
        "to": "backend/photography-document-studio-backend"
      },
      {
        "from": "../build/macos_app/playwright",
        "to": "playwright"
      },
      {
        "from": "../build/macos_app/legacy_data_dir.txt",
        "to": "legacy_data_dir.txt"
      }
    ],
    "mac": {
      "target": "dir",
      "icon": "../build/macos_app/contract-studio.icns",
      "category": "public.app-category.photography",
      "identity": "-",
      "signIgnore": [
        "playwright"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
